# ===== AI PR Review 助手 环境变量模板 =====
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不入库。

# ---- 默认 LLM 后端：DeepSeek（OpenAI 兼容协议）----
DEEPSEEK_API_KEY=
# base_url 不要加 /v1，openai SDK 会自动补全（见复盘 L-XX 经验）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---- 备用 / 交叉验证 LLM：Azure OpenAI（GPT-4.1-mini）----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# ---- GitHub（拉取 PR 变更用，只读 public 时可留空匿名，但会限流）----
GH_TOKEN=

# ---- 服务运行参数 ----
APP_HOST=0.0.0.0
APP_PORT=8080
# 前端允许的跨域来源，逗号分隔的白名单（不要用 *：本服务 allow_credentials=False，
# 但白名单仍是纵深防御）。留空则用代码内默认（线上域 + 本地开发域）。
CORS_ORIGINS=https://pr.qiniu.zdwktlj.top,http://localhost:5173,http://127.0.0.1:5173
# 公开端点防刷：每 IP 每窗口最多 N 次
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60
